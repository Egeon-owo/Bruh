[Argument]
抓取Cookie = switch,true,tag=抓取Cookie
RunTime = input,"11 8 * * *",tag=执行时间

[Script]
cron {RunTime} script-path=https://raw.githubusercontent.com/NobyDa/Script/master/BDTieBa-DailyBonus/TieBa.js, tag=百度贴吧签到, timeout=60

http-response ^https?:\/\/(c\.tieba|tiebac)\.baidu\.com\/c\/s\/login script-path=https://raw.githubusercontent.com/NobyDa/Script/master/BDTieBa-DailyBonus/TieBa.js,tag=百度贴吧抓取Cookie,enable={抓取Cookie}, timeout=60

[MITM]
hostname = c.tieba.baidu.com, tiebac.baidu.com
