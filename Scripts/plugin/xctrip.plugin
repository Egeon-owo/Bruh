#!name=携程旅行自动签到
#!icon=https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1085.png
#!desc=！
[Argument]
抓取Cookie = switch,true,tag=抓取Cookie
RunTime = input,"11 8 * * *",tag=执行时间

[Script]
cron {RunTime} script-path=https://raw.githubusercontent.com/NobyDa/Script/master/Ctrip-DailyBonus/Ctrip.js, tag=携程旅行每日签到, timeout=60

http-response ^https:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/[a-zA-Z]+Login(?:$|\?) script-path=https://raw.githubusercontent.com/NobyDa/Script/master/Ctrip-DailyBonus/Ctrip.js,requires-body=true,tag=携程旅行抓取Cookie,enable={抓取Cookie}, timeout=60

[MITM]
hostname = m.ctrip.com
